{
  "$schema": "https://raw.githubusercontent.com/nicedoc/open/master/tauri.conf.schema.json",
  "productName": "极思G界址点互转工具",
  "version": "3.1.0",
  "identifier": "com.jisig.bpoint-converter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "极思G界址点互转工具",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 540,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: asset:; connect-src 'self' https://api.github.com https://github.com https://*.githubusercontent.com",
      "dangerousDisableAssetCspModification": true
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://cdn.jsdelivr.net/gh/edcfoshan/polygon-txt@master/latest.json",
        "https://github.com/edcfoshan/polygon-txt/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbWU6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMjYzRkZGQzk3RkI1RjAKUldUd3RYL0ovejhtb05aR2YxeFIrNHNTZDNMdlE0Q01kY2dxMXUvaktBdnlka0VhV2dyTkV2YWUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
